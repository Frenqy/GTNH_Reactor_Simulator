{
    "name": "gtnh-reactor",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "dist:win": "npm run build && electron-builder --win --x64 --publish never",
        "lint": "eslint .",
        "preview": "vite preview"
    },
    "dependencies": {
        "antd": "^6.1.1",
        "lodash": "^4.17.21",
        "react": "^19.2.0",
        "react-dom": "^19.2.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@types/jquery": "^3.5.33",
        "@types/lodash": "^4.17.21",
        "@types/node": "^24.10.1",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.1",
        "babel-plugin-react-compiler": "^1.0.0",
        "electron": "^36.2.1",
        "electron-builder": "^26.0.12",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.46.4",
        "vite": "^7.2.4"
    },
    "build": {
        "appId": "com.frenqy.gtnhreactorsimulator",
        "productName": "GTNH-Reactor-Simulator",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        }
    }
}
